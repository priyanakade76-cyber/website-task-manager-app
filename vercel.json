{
  "version": 2,
  "builds": [
    {
      "src": "index.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": ["public/**", "server/**"]
      }
    },
    {
      "src": "public/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "index.js"
    },
    {
      "src": "/register",
      "dest": "public/register.html"
    },
    {
      "src": "/login",
      "dest": "public/login.html"
    },
    {
      "src": "/dashboard",
      "dest": "public/dashboard.html"
    },
    {
      "src": "/tasks",
      "dest": "public/tasks.html"
    },
    {
      "src": "/calendar",
      "dest": "public/calendar.html"
    },
    {
      "src": "/profile",
      "dest": "public/profile.html"
    },
    {
      "src": "/",
      "dest": "public/index.html"
    },
    {
      "src": "/(.*)",
      "dest": "public/$1"
    }
  ]
}
